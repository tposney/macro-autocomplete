<div class="standard-form">
  <fieldset>
    <legend>Linked Scenes</legend>
    {{#if scenes.length}}
    <ol class="scene-list">
      {{#each scenes as |scene|}}
      <li class="scene-entry flexrow" data-scene-id="{{scene.id}}">
        <span class="scene-name">{{scene.name}}</span>
        <span class="scene-composition">{{scene.compositionLabel}}</span>
        <div class="scene-actions">
          {{#if scene.isActive}}
          <span class="tag active"><i class="fa-solid fa-play"></i> Active</span>
          <a data-action="openPlacementEditor" data-scene-id="{{scene.id}}"
             data-tooltip="Open Placement Editor">
            <i class="fa-solid fa-crosshairs"></i>
          </a>
          {{else}}
          <a data-action="activateScene" data-scene-id="{{scene.id}}"
             data-tooltip="Activate Scene">
            <i class="fa-solid fa-play"></i>
          </a>
          {{/if}}
          <a data-action="deleteScene" data-scene-id="{{scene.id}}"
             data-tooltip="Delete Scene">
            <i class="fa-solid fa-trash"></i>
          </a>
        </div>
      </li>
      {{/each}}
    </ol>
    {{else}}
    <p class="hint">No scenes are linked to this vista. Create one to see it rendered.</p>
    {{/if}}
  </fieldset>

  <fieldset>
    <legend>Create Scene</legend>
    <div class="form-group">
      <label>Scene Name</label>
      <div class="form-fields">
        <input type="text" id="mac-new-scene-name" placeholder="{{vistaLabel}}">
      </div>
    </div>
    <div class="form-group">
      <label>Composition</label>
      <div class="form-fields">
        <select id="mac-new-scene-composition">
          {{#each compositionChoices as |comp|}}
          <option value="{{comp.id}}">{{comp.label}}</option>
          {{/each}}
        </select>
      </div>
    </div>
    <button type="button" data-action="createScene">
      <i class="fa-solid fa-plus"></i> Create Scene
    </button>
  </fieldset>
</div>
